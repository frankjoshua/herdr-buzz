#!/usr/bin/env bash
# One-time setup, run in a Herdr popup: writes ~/.config/buzz-acp/owner.env, checks the tools,
# offers to add the prefix+y binding. Safe to re-run.
set -uo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
cfg="$HOME/.config/buzz-acp"; mkdir -p "$cfg/agents"
cur_nsec=""; cur_relay=""
[ -f "$cfg/owner.env" ] && { cur_nsec=$(grep -o '^BUZZ_OWNER_NSEC=.*' "$cfg/owner.env" | cut -d= -f2-); cur_relay=$(grep -o '^BUZZ_RELAY_URL=.*' "$cfg/owner.env" | cut -d= -f2-); }
echo "herdr-buzz setup"; echo
echo "Your Buzz private key (Buzz Desktop → Settings → Private key). It signs your agents as yours"
echo "and posts what you type in a pane as you. Stored only in $cfg/owner.env (mode 600)."
read -r -p "nsec [${cur_nsec:+keep current}]: " nsec; nsec=${nsec:-$cur_nsec}
read -r -p "relay URL [${cur_relay:-wss://...}]: " relay; relay=${relay:-$cur_relay}
if [ -z "$nsec" ] || [ -z "$relay" ]; then echo "need both; nothing written"; read -r -p "enter to close"; exit 1; fi
umask 077; tmp=$(mktemp); printf 'BUZZ_OWNER_NSEC=%s\nBUZZ_RELAY_URL=%s\n' "$nsec" "$relay" > "$tmp"
if ! err=$(python3 "$here/mint.py" --owner-env "$tmp" --owner-pubkey 2>&1 >/dev/null); then   # must parse as a 32-byte key
  rm -f "$tmp"; echo "that key doesn't parse (${err##*: }); nothing written"; read -r -p "enter to close"; exit 1
fi
mv "$tmp" "$cfg/owner.env"
echo; echo "checks:"
python3 "$here/mint.py" --selfcheck | tail -1
for b in buzz buzz-acp herdr; do command -v $b >/dev/null && echo "  $b: ok" || echo "  $b: NOT FOUND"; done
[ -x "$here/.venv/bin/herdr-acp" ] && echo "  herdr-acp: ok" || echo "  herdr-acp: missing — run scripts/install.sh"
conf="$HOME/.config/herdr/config.toml"
if ! grep -q 'herdr-buzz.toggle' "$conf" 2>/dev/null; then
  echo; read -r -p "Add the prefix+y binding to $conf? [Y/n] " yn
  case "${yn:-Y}" in [Yy]*) printf '\n# herdr-buzz: attach/detach the focused pane to a Buzz channel\n[[keys.command]]\nkey = "prefix+y"\ntype = "plugin_action"\ncommand = "herdr-buzz.toggle"\ndescription = "Buzz: attach/detach focused pane"\n' >> "$conf"; herdr server reload-config >/dev/null 2>&1 && echo "  bound prefix+y";; esac
fi
if ! grep -q '\$buzz' "$conf" 2>/dev/null; then
  echo; read -r -p "Show '⇄ #channel' under bridged agents in the sidebar (adds a \$buzz row to [ui.sidebar.agents])? [Y/n] " yn
  case "${yn:-Y}" in [Yy]*) python3 - "$conf" <<'PY'
import re,sys; p=sys.argv[1]; s=open(p).read()
m=re.search(r"\[ui\.sidebar\.agents\]\s*\nrows = \[", s)
if m: s=s[:m.end()]+'\n  [{ token = "$buzz", fg = "#f0a72a" }],'+s[m.end():]
else: s+='\n[ui.sidebar.agents]\nrows = [\n  ["state_icon", "workspace", "tab"],\n  ["agent"],\n  [{ token = "$buzz", fg = "#f0a72a" }],\n]\n'
open(p,"w").write(s)
PY
    herdr server reload-config >/dev/null 2>&1 && echo "  sidebar row added";; esac
fi
echo; echo "done. Focus an agent pane and press prefix+y."; read -r -p "enter to close"
