#!/usr/bin/env bash
# Run buzz-acp for one Herdr pane under a minted agent identity. Run it in its own Herdr pane.
#   herdr-buzz <agent-name> <pane-id> <channel-id> [extra buzz-acp flags...]
# Identity: ~/.config/buzz-acp/agents/<agent-name>.env (from `python mint.py`).
# The pane's own shell must have sourced the same env file so the agent can `buzz messages send`.
set -euo pipefail
name=$1; pane=$2; channel=$3; shift 3
set -a; . "$HOME/.config/buzz-acp/agents/$name.env"; set +a
: "${HERDR_ACP:=$HOME/development/workspace/herdr-acp/.venv/bin/herdr-acp}"
# buzz-acp's prompt tells the agent to thread replies; Josh wants top-level channel posts.
# Existing panes were started without the Buzz env, so the reply command sources it inline.
export HERDR_ACP_FOOTER="[herdr-buzz] Reply with: set -a; . $HOME/.config/buzz-acp/agents/$name.env; set +a; buzz messages send --channel <id> --content '...'  (top-level: no --reply-to unless the human explicitly asked for a thread)."
exec "$HOME/buzz/target/release/buzz-acp" \
  --agent-command "$HERDR_ACP" --agent-args="--pane,$pane" \
  --channels "$channel" --subscribe all --kinds 9 --no-mention-filter --relay-observer \
  --idle-timeout 120 --multiple-event-handling queue "$@"
