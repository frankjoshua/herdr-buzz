#!/usr/bin/env bash
# Herdr plugin action: attach the focused pane to Buzz, or detach it if already attached.
# Agent name and channel name = the workspace label. Identity is minted on first use.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
pane=${HERDR_PANE_ID:?no focused pane}
state=${HERDR_PLUGIN_STATE_DIR:-$HOME/.config/buzz-acp/bridges}; mkdir -p "$state"
mark="$state/${pane//:/_}"

if [ -f "$mark" ]; then                                   # detach
  herdr pane close "$(cat "$mark")" >/dev/null 2>&1 || true
  herdr pane report-metadata "$pane" --source herdr-buzz --clear-display-agent --clear-token buzz >/dev/null 2>&1 || true
  rm -f "$mark"; exit 0
fi

ws=${pane%%:*}
label=$(herdr workspace get "$ws" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["workspace"]["label"])')
name=$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//'); name=${name:-pane-${pane//:/-}}

set -a; . "$HOME/.config/buzz-acp/owner.env"; . "$HOME/.config/buzz-acp/agent.env"; set +a   # relay url + a key that can search
channel=$(buzz channels search --query "$name" | python3 -c '
import json,sys; want=sys.argv[1]
hits=[c for c in json.load(sys.stdin) if c["name"]==want and not c.get("archived")]
print(hits[0]["channel_id"] if hits else "")' "$name")
if [ -z "$channel" ]; then
  channel=$(env -u BUZZ_AUTH_TAG BUZZ_PRIVATE_KEY="$BUZZ_OWNER_NSEC" buzz channels create --name "$name" --type stream --visibility open \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["channel_id"])')
fi

env_file="$HOME/.config/buzz-acp/agents/$name.env"
if [ ! -f "$env_file" ]; then
  python3 "$here/mint.py" --name "$name" --channel "$channel" >/dev/null
else                                                      # make sure it's in this channel as a bot
  . "$env_file"
  env -u BUZZ_AUTH_TAG BUZZ_PRIVATE_KEY="$BUZZ_OWNER_NSEC" buzz channels add-member --channel "$channel" --pubkey "$BUZZ_PUBLIC_KEY" --role bot >/dev/null 2>&1 || true
fi

bridge=$(herdr pane split "$pane" --direction down --ratio 0.2 --cwd "$here" \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')
herdr pane rename "$bridge" "buzz: #$name" >/dev/null 2>&1 || true
flags=$(cat "$HOME/.config/buzz-acp/herdr-buzz.flags" 2>/dev/null || true)   # e.g. --respond-to anyone
herdr pane run "$bridge" "exec $here/bin/herdr-buzz $name $pane $channel $flags 2>&1 | grep -v acp::thought"
agent=$(herdr pane get "$pane" | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"].get("agent") or "shell")')
herdr pane report-metadata "$pane" --source herdr-buzz --display-agent "$agent ⇄ #$name" --token "buzz=#$name" >/dev/null 2>&1 || true
echo "$bridge" > "$mark"
