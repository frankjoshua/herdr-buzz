#!/usr/bin/env bash
# Herdr event hook: a bridged pane went away → stop its bridge.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
pane=$(printf '%s' "${HERDR_PLUGIN_EVENT_JSON:-}" | python3 -c 'import json,sys; d=json.load(sys.stdin); print((d.get("data") or d).get("pane_id",""))' 2>/dev/null || true)
state=${HERDR_PLUGIN_STATE_DIR:-$HOME/.local/state/herdr/plugins/herdr-buzz}
[ -n "$pane" ] && [ -f "$state/${pane//:/_}" ] && "$here/bin/bridge" detach "$pane" >/dev/null || true
